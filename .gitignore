node_modules/
.next/
out/
# Every env file except the committed template. `.env*.local` alone was not enough: it leaves a
# plain `.env` tracked, and `.env` is where the Sanity API WRITE token goes — the one credential in
# this project that can create documents in a live dataset. Negation last so `.env.example`, which is
# placeholders only and is meant to be read, still ships.
.env
.env.*
!.env.example
.superpowers/
.playwright-mcp/
test-results/
playwright-report/
blob-report/
playwright/.cache/
lighthouse-*.json
*.tsbuildinfo
.DS_Store

# Next.js build-time artifacts (regenerated automatically)
next-env.d.ts
.vercel

# local tool state (dev-server preview launch config, not an app deliverable)
.claude/

# Cygwin/Git-Bash crash dumps
*.stackdump
